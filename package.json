{
  "name": "@parcellab/eslint-config",
  "version": "0.5.6",
  "description": "Specific parcelLab configuration for JavaScript and TypeScript projects",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./base": "./src/base.js",
    "./jest": "./src/jest.js",
    "./playwright": "./src/playwright.js",
    "./react-testing-library": "./src/react-testing-library.js",
    "./react-ts": "./src/react-ts.js",
    "./react": "./src/react.js",
    "./storybook": "./src/react.js",
    "./typescript": "./src/typescript.js"
  },
  "keywords": [
    "eslint",
    "config",
    "parcellab"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/parcelLab/eslint-config.git"
  },
  "dependencies": {
    "@parcellab/eslint-plugin-no-require-assign": "^0.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@kesills/eslint-config-airbnb-typescript": "^20.0.0",
    "@types/eslint": "^8.56.12",
    "@types/is-ci": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "child_process": "^1.0.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^1.8.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-testing-library": "^6.5.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@kesills/eslint-config-airbnb-typescript": ">=20",
    "@typescript-eslint/parser": ">=5",
    "eslint": ">=8",
    "eslint-config-airbnb": ">=19",
    "eslint-config-prettier": ">=8",
    "eslint-import-resolver-typescript": ">=3",
    "eslint-plugin-import": ">=2",
    "eslint-plugin-jest": ">=26",
    "eslint-plugin-jsx-a11y": ">=6",
    "eslint-plugin-playwright": ">=0.10.0",
    "eslint-plugin-promise": ">=6",
    "eslint-plugin-react": ">=7",
    "eslint-plugin-react-hooks": ">=4",
    "eslint-plugin-storybook": ">=0.6.3",
    "eslint-plugin-testing-library": ">=5",
    "eslint-plugin-unicorn": ">=56",
    "prettier": ">=3"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "eslint-config-airbnb": {
      "optional": true
    },
    "eslint-config-airbnb-typescript": {
      "optional": true
    },
    "eslint-plugin-import": {
      "optional": true
    },
    "eslint-plugin-jest": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-playwright": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-storybook": {
      "optional": true
    },
    "eslint-plugin-testing-library": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo ./.eslintcache",
    "lint": " prettier --check . && eslint  --ext .ts,.tsx,.js,.jsx .",
    "lint:commit": "commitlint -x @commitlint/config-conventional --edit",
    "lint:fix": "prettier --write . && eslint --ext .ts,.tsx,.js,.jsx --fix .",
    "test": "jest",
    "prepare": "is-ci || husky install",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write --allow-empty ",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "author": "engineering@parcellab.com",
  "license": "MIT"
}
